# ─── Entorno ──────────────────────────────────────────────────────────────────
APP_ENV=production
DEBUG=false

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=ampara
POSTGRES_PASSWORD=CAMBIAR_password_fuerte_aqui
POSTGRES_DB=ampara_db
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://ampara:CAMBIAR_password_fuerte_aqui@db:5432/ampara_db

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generar con: openssl rand -hex 32
JWT_SECRET_KEY=CAMBIAR_clave_secreta_minimo_32_caracteres
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# ─── Storage de evidencia ─────────────────────────────────────────────────────
# Las fotos y audios se guardan en disco local dentro del contenedor Docker.
# Para migrar a MinIO/S3: implementar la clase correspondiente y cambiar a 'minio'.
STORAGE_BACKEND=local
UPLOAD_DIR=/app/uploads

# URL pública del backend — prefijo de cada foto/audio guardado en la BD.
# Debe ser accesible desde el celular Y desde el dashboard.
# Ejemplo con IP:     http://203.0.113.10:8000
# Ejemplo con dominio: https://api.ampara.pe
MEDIA_BASE_URL=http://IP_DEL_VPS:8000

# ─── Seguridad ────────────────────────────────────────────────────────────────
# Clave para crear el primer admin con POST /api/v1/auth/setup
# Generar con: openssl rand -hex 32
ADMIN_SECRET_KEY=CAMBIAR_clave_admin_secreta

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Origen del dashboard web. La app móvil NO usa CORS.
# Si el dashboard está en el mismo VPS en puerto 80:
ALLOWED_ORIGINS=["http://IP_DEL_VPS"]

# ─── pgAdmin (opcional) ───────────────────────────────────────────────────────
PGADMIN_EMAIL=admin@ampara.pe
PGADMIN_PASSWORD=CAMBIAR_password_pgadmin

{
  "expo": {
    "name": "Ampara",
    "slug": "ampara",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/ampara-logo.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/ampara-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#6E2DB0"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.ampara.app",
      "buildNumber": "1",
      "infoPlist": {
        "UIBackgroundModes": [
          "fetch"
        ]
      }
    },
    "android": {
      "package": "com.ampara.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/ampara-logo.png",
        "backgroundColor": "#6E2DB0"
      },
      "edgeToEdgeEnabled": true,
      "usesCleartextTraffic": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#6E2DB0",
          "image": "./assets/ampara-logo.png",
          "imageWidth": 200
        }
      ],
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "dfbe6e5b-1224-4b44-9824-b074a07a3938"
      }
    },
    "owner": "emmy_lopez"
  }
}
